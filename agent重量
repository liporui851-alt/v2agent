local expanded = {}
local treeOrder = 0
local function refreshTree()
    for _, c in ipairs(treeScroll:GetChildren()) do
        if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then c:Destroy() end
    end
    treeOrder = 0
    local function walk(inst, depth)
        if depth > 6 then return end
        treeOrder += 1
        local hasChild = #inst:GetChildren() > 0
        local arrow = hasChild and (expanded[inst] and "▼" or "▶") or "•"
        local row = button(treeScroll, "", {
            Size = UDim2.new(1, -6, 0, 26),
            BackgroundColor3 = COLORS.panelRaised,
            BackgroundTransparency = 0.5,
            Text = "", TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = treeOrder, ZIndex = 653,
        })
        label(row, arrow, 10, COLORS.muted, FONT_REGULAR, {
            Position = UDim2.fromOffset(6, 0), Size = UDim2.fromOffset(16, 26), ZIndex = 654,
        })
        label(row, inst.Name, 11, COLORS.text, FONT_REGULAR, {
            Position = UDim2.fromOffset(24, 0), Size = UDim2.new(1, -80, 0, 26), ZIndex = 654,
        })
        label(row, inst.ClassName, 9, COLORS.muted, FONT_CODE, {
            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 0),
            Size = UDim2.fromOffset(120, 26),
            TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 654,
        })
        bindClick(row, function()
            if hasChild then
                expanded[inst] = not expanded[inst]
                refreshTree()
            end
        end)
        if expanded[inst] then
            for _, c in ipairs(inst:GetChildren()) do
                walk(c, depth + 1)
            end
        end
    end
    expanded[game] = true
    walk(game, 0)
end

