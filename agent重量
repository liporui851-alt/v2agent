makeToolButton("🎨", "切换主题", function()
    local themes = {"translucent", "white", "dark"}
    local names = {"半透明", "白色", "黑灰"}
    local idx = 1
    for i, k in ipairs(themes) do
        if k == CONFIG.THEME then idx = i break end
    end
    idx = idx % #themes + 1
    CONFIG.THEME = themes[idx]
    showToast("主题: " .. names[idx], COLORS.accent, "🎨")
end, 7)

