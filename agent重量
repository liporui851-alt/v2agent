-- 动画注册表
-- ============================================================
local AnimRegistry = { tasks = {} }

function AnimRegistry:add(owner, fn)
    local task = { owner = owner, fn = fn, alive = true }
    table.insert(self.tasks, task)
    return task
end

function AnimRegistry:remove(task)
    task.alive = false
end

local animTime = 0
RunService.Heartbeat:Connect(function(dt)
    animTime = animTime + dt
    for i = #AnimRegistry.tasks, 1, -1 do
        local task = AnimRegistry.tasks[i]
        if not task.alive or not task.owner or not task.owner.Parent then
            table.remove(AnimRegistry.tasks, i)
        else
            pcall(task.fn, dt, animTime)
        end
    end
end)

