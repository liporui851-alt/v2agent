local function new(c, p)
    local o = Instance.new(c)
    if p then for k, v in pairs(p) do o[k] = v end end
    return o
end

local function corner(p, r)
    return new("UICorner", {CornerRadius = UDim.new(0, r), Parent = p})
end

local function stroke(p, color, trans, thick)
    return new("UIStroke", {
        Color = color, Transparency = trans or 0, Thickness = thick or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = p,
    })
end

local function gradient(p, from, to, rot)
    return new("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, from),
            ColorSequenceKeypoint.new(1, to),
        }),
        Rotation = rot or 0, Parent = p,
    })
end

local function padding(p, l, r, t, b)
    return new("UIPadding", {
        PaddingLeft = UDim.new(0, l), PaddingRight = UDim.new(0, r),
        PaddingTop = UDim.new(0, t), PaddingBottom = UDim.new(0, b),
        Parent = p,
    })
end

local function label(p, text, size, color, font, props)
    local l = new("TextLabel", {
        BackgroundTransparency = 1, Text = text, TextColor3 = color,
        TextSize = size, Font = font or FONT_REGULAR,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTransparency = 0, Parent = p,
    })
    if props then for k, v in pairs(props) do l[k] = v end end
    return l
end

local function button(p, text, props)
    local b = new("TextButton", {
        BackgroundColor3 = COLORS.panel, BorderSizePixel = 0,
        Text = text, TextColor3 = COLORS.text, TextSize = 13,
        Font = FONT_SEMI, AutoButtonColor = false,
        TextTransparency = 0, Parent = p,
    })
    corner(b, 8)
    stroke(b, COLORS.border, 0.68, 1)
    if props then for k, v in pairs(props) do b[k] = v end end
    return b
end

local function bindClick(btn, fn)
    btn.MouseButton1Click:Connect(fn)
    btn.Activated:Connect(fn)
end

local AnimRegistry = { tasks = {} }
function AnimRegistry:add(owner, fn)
    local t = { owner = owner, fn = fn, alive = true }
    table.insert(self.tasks, t)
    return t
end
function AnimRegistry:remove(t) t.alive = false end

RunService.Heartbeat:Connect(function(dt)
    for i = #AnimRegistry.tasks, 1, -1 do
        local t = AnimRegistry.tasks[i]
        if not t.alive or not t.owner or not t.owner.Parent then
            table.remove(AnimRegistry.tasks, i)
        else
            pcall(t.fn, dt)
        end
    end
end)

