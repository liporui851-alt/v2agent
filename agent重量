local function buildQuickBar()
    local bar = new("Frame", {
        Name = "ExtQuickBar",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(46, 460),
        BackgroundColor3 = COLORS.panel,
        BackgroundTransparency = 0.08,
        BorderSizePixel = 0, Active = true,
        ZIndex = 30, Parent = shell,
    })
    corner(bar, 23)
    stroke(bar, COLORS.border, 0.35, 1)
    new("UIListLayout", {
        Padding = UDim.new(0, 5),
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder, Parent = bar,
    })
    local buttons = {}
    local function makeToolButton(icon, tip, callback, order)
        local btn = new("TextButton", {
            Size = UDim2.fromOffset(36, 36),
            BackgroundColor3 = COLORS.panelRaised,
            BackgroundTransparency = 0.25,
            BorderSizePixel = 0, Text = icon,
            TextColor3 = COLORS.text, TextSize = 17,
            Font = Enum.Font.SourceSansBold,
            AutoButtonColor = false, LayoutOrder = order,
            ZIndex = 31, Parent = bar,
        })
        corner(btn, 18)
        local s = stroke(btn, COLORS.border, 0.5, 1)
        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
                BackgroundTransparency = 0, BackgroundColor3 = COLORS.accent,
                TextColor3 = Color3.fromRGB(255, 255, 255),
                Size = UDim2.fromOffset(40, 40),
            }):Play()
            TweenService:Create(s, TweenInfo.new(0.15), {Color = COLORS.accentBright, Transparency = 0.2}):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
                BackgroundTransparency = 0.25, BackgroundColor3 = COLORS.panelRaised,
                TextColor3 = COLORS.text,
                Size = UDim2.fromOffset(36, 36),
            }):Play()
            TweenService:Create(s, TweenInfo.new(0.15), {Color = COLORS.border, Transparency = 0.5}):Play()
        end)
        btn.MouseButton1Down:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.08), {Size = UDim2.fromOffset(32, 32)}):Play()
        end)
        btn.MouseButton1Up:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.12, Enum.EasingStyle.Back), {Size = UDim2.fromOffset(40, 40)}):Play()
        end)
        bindClick(btn, callback)
        attachTooltip(btn, tip)
        table.insert(buttons, btn)
        return btn
    end
    local dragging, dragStart, startPos
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = bar.Position
        end
    end)
    bar.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            bar.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    return bar, makeToolButton
end

