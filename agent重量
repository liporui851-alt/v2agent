    local function updateTokenDisplay()
        local limitStr = CONFIG.TOKEN_LIMIT_ENABLED and tostring(CONFIG.TOKEN_LIMIT) or "∞"
        tokenLabel.Text = "tokens: " .. state.totalTokens .. " / " .. limitStr
        if CONFIG.TOKEN_LIMIT_ENABLED and state.totalTokens > CONFIG.TOKEN_LIMIT then
            tokenLabel.TextColor3 = COLORS.danger
        elseif CONFIG.TOKEN_LIMIT_ENABLED and state.totalTokens > CONFIG.TOKEN_LIMIT * 0.85 then
            tokenLabel.TextColor3 = COLORS.orange
        else
            tokenLabel.TextColor3 = COLORS.muted
        end
    end

    local function trimConversation()
        if not CONFIG.TOKEN_LIMIT_ENABLED then return end
        while #state.conversationHistory > 2 do
            local est = estimateMessagesTokens(state.conversationHistory) + estimateTokens(buildSystemPrompt())
            if est <= CONFIG.TOKEN_LIMIT then break end
            table.remove(state.conversationHistory, 1)
            table.remove(state.conversationHistory, 1)
        end
    end

