local TOOLS = {}

TOOLS.run_code = function(args)
    local code = args.code
    if not code or code == "" then return "错误: code 为空" end
    local fn, err = loadstring(code)
    if not fn then return "编译失败: " .. tostring(err) end
    local ok, res = pcall(fn)
    if not ok then return "执行失败: " .. tostring(res) end
    if res ~= nil then return "执行成功，返回: " .. tostring(res) end
    return "执行成功"
end

TOOLS.read_file = function(args)
    if not readfile then return "错误: 不支持 readfile" end
    local ok, content = pcall(readfile, args.path)
    if not ok then return "读取失败: " .. tostring(content) end
    if #content > 5000 then return content:sub(1, 5000) .. "\n...[截断]" end
    return content
end

TOOLS.write_file = function(args)
    if not writefile then return "错误: 不支持 writefile" end
    local ok, err = pcall(writefile, args.path, args.content)
    if not ok then return "写入失败: " .. tostring(err) end
    return "写入成功: " .. args.path
end

TOOLS.search_file = function(args)
    if not listfiles then return "错误: 不支持 listfiles" end
    local keyword = args.keyword or ""
    local root = args.root or "."
    local results = {}
    local ok, files = pcall(listfiles, root)
    if not ok then return "搜索失败: " .. tostring(files) end
    for _, f in ipairs(files) do
        if f:lower():find(keyword:lower(), 1, true) then
            table.insert(results, f)
        end
        if #results >= 30 then break end
    end
    if #results == 0 then return "未找到匹配文件" end
    return table.concat(results, "\n")
end

TOOLS.list_dir = function(args)
    if not listfiles then return "错误: 不支持 listfiles" end
    local ok, files = pcall(listfiles, args.path)
    if not ok then return "列目录失败: " .. tostring(files) end
    if #files == 0 then return "目录为空" end
    return table.concat(files, "\n")
end

