    label(panel, "命令历史", 13, COLORS.text, Enum.Font.SourceSansBold, {
        Position = UDim2.fromOffset(14, 12), Size = UDim2.new(1, -60, 0, 20), ZIndex = 36,
    })
    local countLabel = label(panel, "0 条", 10, COLORS.muted, Enum.Font.SourceSans, {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -50, 0, 16),
        Size = UDim2.fromOffset(50, 16),
        TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 36,
    })
    local closeBtn = new("TextButton", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -10, 0, 10),
        Size = UDim2.fromOffset(30, 30),
        BackgroundColor3 = COLORS.panelRaised,
        BorderSizePixel = 0, Text = "×",
        TextColor3 = COLORS.muted, TextSize = 16,
        Font = Enum.Font.SourceSansBold,
        AutoButtonColor = false, ZIndex = 36, Parent = panel,
    })
    corner(closeBtn, 6)
    bindClick(closeBtn, function() panel.Visible = false end)
    local scroll = new("ScrollingFrame", {
        Position = UDim2.fromOffset(10, 48),
        Size = UDim2.new(1, -20, 1, -58),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 4, ScrollBarImageColor3 = COLORS.border,
        ZIndex = 36, Parent = panel,
    })
    new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
    local function refresh()
        for _, child in ipairs(scroll:GetChildren()) do
            if not child:IsA("UIListLayout") then child:Destroy() end
        end
        countLabel.Text = #commandHistory .. " 条"
        if #commandHistory == 0 then
            label(scroll, "还没有历史记录", 11, COLORS.muted, Enum.Font.SourceSans, {
                Size = UDim2.new(1, 0, 0, 30),
                TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 37,
            })
            return
        end
        for i, item in ipairs(commandHistory) do
            local row = new("TextButton", {
                Size = UDim2.new(1, -6, 0, 46),
                BackgroundColor3 = COLORS.panelRaised,
                BackgroundTransparency = 0.35,
                BorderSizePixel = 0, Text = "",
                AutoButtonColor = false, LayoutOrder = i,
                ZIndex = 37, Parent = scroll,
            })
            corner(row, 6)
            stroke(row, COLORS.border, 0.6, 1)
            label(row, item.text:sub(1, 50) .. (#item.text > 50 and "..." or ""), 11, COLORS.text, Enum.Font.SourceSans, {
                Position = UDim2.fromOffset(10, 6), Size = UDim2.new(1, -60, 0, 18), ZIndex = 38,
            })
            label(row, formatTime(item.time), 9, COLORS.muted, Enum.Font.Code, {
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -10, 0, 7),
                Size = UDim2.fromOffset(50, 14),
                TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 38,
            })
            label(row, "点击填入", 9, COLORS.accent, Enum.Font.SourceSans, {
                Position = UDim2.fromOffset(10, 26), Size = UDim2.fromOffset(80, 12), ZIndex = 38,
            })
            bindClick(row, function()
                local box
                for _, d in ipairs(shell:GetDescendants()) do
                    if d:IsA("TextBox") and d.PlaceholderText:find("Codex") then box = d break end
                end
                if box then
                    box.Text = item.text
                    box:CaptureFocus()
                    toast("已填入输入框", COLORS.green, "✓")
                end
                panel.Visible = false
            end)
        end
    end
    return panel, refresh
end

