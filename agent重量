local function estimateTokens(text)
    if not text then return 0 end
    return math.ceil(#text / 4)
end

local function estimateMessagesTokens(messages)
    local total = 0
    for _, m in ipairs(messages) do
        total = total + estimateTokens(m.content) + 4
    end
    return total
end

local TOOLS = {}

TOOLS.run_code = function(args)
    local code = args.code
    if not code or code == "" then return "错误: code 为空" end
    local fn, err = loadstring(code)
    if not fn then return "编译失败: " .. tostring(err) end
    local ok, res = pcall(fn)
    if not ok then return "执行失败: " .. tostring(res) end
    if res ~= nil then return "执行成功，返回: " .. tostring(res) end
    return "执行成功"
end

TOOLS.read_file = function(args)
    if not readfile then return "错误: 不支持 readfile" end
    local ok, content = pcall(readfile, args.path)
    if not ok then return "读取失败: " .. tostring(content) end
    if #content > 5000 then return content:sub(1, 5000) .. "\n...[截断]" end
    return content
end

TOOLS.write_file = function(args)
    if not writefile then return "错误: 不支持 writefile" end
    local ok, err = pcall(writefile, args.path, args.content)
    if not ok then return "写入失败: " .. tostring(err) end
    return "写入成功: " .. args.path
end

TOOLS.search_file = function(args)
    if not listfiles then return "错误: 不支持 listfiles" end
    local keyword = args.keyword or ""
    local root = args.root or "."
    local results = {}
    local ok, files = pcall(listfiles, root)
    if not ok then return "搜索失败: " .. tostring(files) end
    for _, f in ipairs(files) do
        if f:lower():find(keyword:lower(), 1, true) then
            table.insert(results, f)
        end
        if #results >= 30 then break end
    end
    if #results == 0 then return "未找到匹配文件" end
    return table.concat(results, "\n")
end

TOOLS.list_dir = function(args)
    if not listfiles then return "错误: 不支持 listfiles" end
    local ok, files = pcall(listfiles, args.path)
    if not ok then return "列目录失败: " .. tostring(files) end
    if #files == 0 then return "目录为空" end
    return table.concat(files, "\n")
end

local function autoExecute(code)
    if not code or code == "" then return false, "空代码" end
    local fn, err = loadstring(code)
    if not fn then return false, "编译失败: " .. tostring(err) end
    local ok, res = pcall(fn)
    if not ok then return false, "执行失败: " .. tostring(res) end
    return true, res ~= nil and tostring(res) or "执行成功"
end

local function callDeepSeek(messages)
    local bodyTable = {
        model = CONFIG.MODEL,
        messages = messages,
        temperature = CONFIG.TEMPERATURE,
    }
    if CONFIG.TOKEN_LIMIT_ENABLED then
        bodyTable.max_tokens = CONFIG.TOKEN_PER_REPLY
    end
    local body = HttpService:JSONEncode(bodyTable)
    local headers = {
        ["Content-Type"] = "application/json",
        ["Authorization"] = "Bearer " .. CONFIG.API_KEY,
    }
    if request then
        local ok, response = pcall(function()
            return request({Url = CONFIG.API_URL, Method = "POST", Headers = headers, Body = body})
        end)
        if not ok then return nil, "请求失败: " .. tostring(response) end
        if response.StatusCode ~= 200 then return nil, "API 错误 " .. tostring(response.StatusCode) end
        local data = HttpService:JSONDecode(response.Body)
        return data.choices[1].message.content, nil
    else
        local ok, response = pcall(function()
            return HttpService:RequestAsync({Url = CONFIG.API_URL, Method = "POST", Headers = headers, Body = body})
        end)
        if not ok then return nil, "请求失败: " .. tostring(response) end
        if not response.Success then return nil, "API 错误 " .. tostring(response.StatusCode) end
        local data = HttpService:JSONDecode(response.Body)
        return data.choices[1].message.content, nil
    end
end

local function parseToolCall(text)
    text = text:gsub("```%w*\n", ""):gsub("```", "")
    local tool = text:match("[Tt][Oo][Oo][Ll]:%s*([%w_]+)")
    local argsJson = text:match("[Aa][Rr][Gg][Ss]:%s*(%b{})")
    if tool and argsJson then
        local ok, args = pcall(HttpService.JSONDecode, HttpService, argsJson)
        if ok then return tool, args end
    end
    return nil, nil
end

local function extractCode(text)
    local code = text:match("START%s*\n(.-)\n%s*END")
    if code then return code end
    return text:match("START%s*(.-)%s*END")
end

local AnimRegistry = { tasks = {} }

function AnimRegistry:add(owner, fn)
    local t = { owner = owner, fn = fn, alive = true }
    table.insert(self.tasks, t)
    return t
end

function AnimRegistry:remove(t)
    t.alive = false
end

local animTime = 0
RunService.Heartbeat:Connect(function(dt)
    animTime = animTime + dt
    for i = #AnimRegistry.tasks, 1, -1 do
        local t = AnimRegistry.tasks[i]
        if not t.alive or not t.owner or not t.owner.Parent then
            table.remove(AnimRegistry.tasks, i)
        else
            pcall(t.fn, dt, animTime)
        end
    end
end)

