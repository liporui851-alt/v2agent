local function callDeepSeek(messages)
    local bodyTable = {
        model = CONFIG.MODEL,
        messages = messages,
        temperature = CONFIG.TEMPERATURE,
    }
    if CONFIG.TOKEN_LIMIT_ENABLED then
        bodyTable.max_tokens = CONFIG.TOKEN_PER_REPLY
    end
    local body = HttpService:JSONEncode(bodyTable)
    local headers = {
        ["Content-Type"] = "application/json",
        ["Authorization"] = "Bearer " .. CONFIG.API_KEY,
    }
    if request then
        local ok, response = pcall(function()
            return request({Url = CONFIG.API_URL, Method = "POST", Headers = headers, Body = body})
        end)
        if not ok then return nil, "请求失败: " .. tostring(response) end
        if response.StatusCode ~= 200 then return nil, "API 错误 " .. tostring(response.StatusCode) end
        local data = HttpService:JSONDecode(response.Body)
        return data.choices[1].message.content, nil
    else
        local ok, response = pcall(function()
            return HttpService:RequestAsync({Url = CONFIG.API_URL, Method = "POST", Headers = headers, Body = body})
        end)
        if not ok then return nil, "请求失败: " .. tostring(response) end
        if not response.Success then return nil, "API 错误 " .. tostring(response.StatusCode) end
        local data = HttpService:JSONDecode(response.Body)
        return data.choices[1].message.content, nil
    end
end

local function parseToolCall(text)
    text = text:gsub("```%w*\n", ""):gsub("```", "")
    local tool = text:match("[Tt][Oo][Oo][Ll]:%s*([%w_]+)")
    local argsJson = text:match("[Aa][Rr][Gg][Ss]:%s*(%b{})")
    if tool and argsJson then
        local ok, args = pcall(HttpService.JSONDecode, HttpService, argsJson)
        if ok then return tool, args end
    end
    return nil, nil
end

local function extractCode(text)
    local code = text:match("START%s*\n(.-)\n%s*END")
    if code then return code end
    return text:match("START%s*(.-)%s*END")
end

