-- ============================================================
-- 启动
-- ============================================================
local function startAgent()
    local ui = createUI()
    local running = false
    local conversation = {}
    local lastCode = ""
    local totalTokens = 0

    local function log(sender, text, color, icon)
        ui.addMessage(sender, text, color, icon)
    end

    local function updateTokenDisplay()
        local limitStr = CONFIG.TOKEN_LIMIT_ENABLED and tostring(CONFIG.TOKEN_LIMIT) or "∞"
        ui.tokenDisplay.Text = "tokens: " .. totalTokens .. " / " .. limitStr
        if CONFIG.TOKEN_LIMIT_ENABLED and totalTokens > CONFIG.TOKEN_LIMIT then
            ui.tokenDisplay.TextColor3 = C.red
        elseif CONFIG.TOKEN_LIMIT_ENABLED and totalTokens > CONFIG.TOKEN_LIMIT * 0.85 then
            ui.tokenDisplay.TextColor3 = C.yellow
        else
            ui.tokenDisplay.TextColor3 = C.dim2
        end
    end

    local function trimConversation()
        if not CONFIG.TOKEN_LIMIT_ENABLED then return end
        while #conversation > 2 do
            local est = estimateMessagesTokens(conversation) + estimateTokens(buildSystemPrompt())
            if est <= CONFIG.TOKEN_LIMIT then break end
            table.remove(conversation, 1)
            table.remove(conversation, 1)
        end
    end

    local function runAgent(userInput)
        if running then
            log("系统", "上一个任务还在跑", C.yellow, "⚠")
            return
        end
        running = true

        CONFIG.API_KEY = ui.keyBox.Text
        if CONFIG.API_KEY == "" then
            log("系统", "先填 API Key", C.red, "✕")
            ui.say("缺少 Key")
            running = false
            return
        end

        table.insert(conversation, { role = "user", content = userInput })
        trimConversation()

        local messages = { { role = "system", content = buildSystemPrompt() } }
        for _, m in ipairs(conversation) do
            table.insert(messages, m)
        end

        local loopCount = 0
        while loopCount < CONFIG.MAX_LOOPS do
            loopCount = loopCount + 1
            ui.setThinking("思考中")

            local reply, err = callDeepSeek(messages)
            if err then
                ui.stopThinking()
                log("错误", err, C.red, "✕")
                ui.say("失败")
                running = false
                return
            end

            totalTokens = estimateMessagesTokens(messages) + estimateTokens(reply)
            updateTokenDisplay()

            if CONFIG.TOKEN_LIMIT_ENABLED and totalTokens > CONFIG.TOKEN_LIMIT then
                log("系统", "已超出 token 上限，停止", C.red, "⚠")
                ui.say("超出限制")
                running = false
                return
            end

            table.insert(messages, { role = "assistant", content = reply })
            table.insert(conversation, { role = "assistant", content = reply })

            local tool, args = parseToolCall(reply)

            if tool and TOOLS[tool] then
                ui.stopThinking()
                local preview
                if tool == "run_code" then
                    preview = (args.code or ""):sub(1, 200)
                    lastCode = args.code or ""
                else
                    preview = HttpService:JSONEncode(args):sub(1, 200)
                end
                log("AI", "调用 " .. tool .. ":\n" .. preview, C.accent, "▶")
                ui.setThinking("执行 " .. tool)

                local result = TOOLS[tool](args)
                ui.stopThinking()
                local ok = not result:find("失败") and not result:find("错误")
                log("结果", result:sub(1, 200), ok and C.green or C.red, ok and "✓" or "✕")

                local toolMsg = tool .. " 返回: " .. result
                table.insert(messages, { role = "user", content = toolMsg })
                table.insert(conversation, { role = "user", content = toolMsg })
            else
                ui.stopThinking()
                local extracted = extractCode(reply)
                if extracted then
                    lastCode = extracted
                    log("AI", extracted:sub(1, 200), C.accent, "📋")
                    ui.say("已提取代码，点复制")
                else
                    log("AI", reply, C.text, "●")
                    ui.say("ready")
                end
                running = false
                return
            end
        end

        ui.stopThinking()
        log("系统", "达到循环上限", C.yellow, "⚠")
        ui.say("达到上限")
        running = false
    end

    ui.copyBtn.MouseButton1Click:Connect(function()
        if lastCode == "" then
            log("系统", "还没有可复制的代码", C.yellow, "⚠")
            return
        end
        if setclipboard then
            setclipboard(lastCode)
            log("系统", "已复制到剪贴板 (" .. #lastCode .. " 字符)", C.green, "✓")
        else
            log("系统", "当前环境没有 setclipboard", C.red, "✕")
        end
    end)

    ui.sendBtn.MouseButton1Click:Connect(function()
        local text = ui.inputBox.Text
        if text == "" then return end
        ui.inputBox.Text = ""
        log("你", text, C.text, "○")
        task.spawn(runAgent, text)
    end)

    ui.inputBox.FocusLost:Connect(function(enter)
        if enter then ui.sendBtn:Fire() end
    end)

    updateTokenDisplay()
    log("系统", "AI 控制中心已启动 · 等待指令", C.green, "✓")
    ui.say("ready")
end

showKeyGate(function()
    startAgent()
end)
