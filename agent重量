local function createThinkingDots(parent)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.fromOffset(48, 14)
    holder.BackgroundTransparency = 1
    holder.Visible = false
    holder.Parent = parent

    local dots = {}
    for i = 1, 3 do
        local d = Instance.new("Frame")
        d.Size = UDim2.fromOffset(5, 5)
        d.Position = UDim2.fromOffset((i-1) * 12, 5)
        d.BackgroundColor3 = C.accent
        d.BorderSizePixel = 0
        d.Parent = holder
        local dc = Instance.new("UICorner")
        dc.CornerRadius = UDim.new(1, 0)
        dc.Parent = d
        table.insert(dots, d)
    end

    local active = false
    AnimRegistry:add(holder, function(dt, t)
        if not active then return end
        for i, d in ipairs(dots) do
            local phase = t * 4 - (i - 1) * 0.5
            local y = math.abs(math.sin(phase)) * -5
            d.Position = UDim2.fromOffset((i-1) * 12, 5 + y)
            d.BackgroundTransparency = 1 - (0.5 + 0.5 * math.abs(math.sin(phase)))
        end
    end)

    return holder,
        function() holder.Visible = true; active = true end,
        function() holder.Visible = false; active = false end
end

