-- 快捷键
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    local isCtrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
        or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
    if isCtrl and input.KeyCode == Enum.KeyCode.H then
        refreshHistory()
        historyPanel.Visible = not historyPanel.Visible
    elseif isCtrl and input.KeyCode == Enum.KeyCode.W then
        refreshTree()
        wsPanel.Visible = not wsPanel.Visible
    end
end)

