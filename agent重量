        local tweenInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        local isSupreme = currentLevel == #REASONING_LEVELS

        TweenService:Create(levelFill, tweenInfo, {
            Size = UDim2.new(progress, 0, 1, 0),
        }):Play()
        TweenService:Create(levelKnob, tweenInfo, {
            Position = UDim2.new(progress, 0, 0.5, 0),
        }):Play()

        if isSupreme then
            TweenService:Create(levelFill, tweenInfo, {BackgroundColor3 = PURPLE}):Play()
            TweenService:Create(levelKnob, tweenInfo, {BackgroundColor3 = PURPLE_BRIGHT}):Play()
            TweenService:Create(levelTrackStroke, tweenInfo, {Color = PURPLE}):Play()
            TweenService:Create(levelKnobStroke, tweenInfo, {Color = PURPLE_BRIGHT}):Play()
            levelFillGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, PURPLE_BRIGHT),
                ColorSequenceKeypoint.new(1, PURPLE_DARK),
