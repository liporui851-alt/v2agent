local function makeStatusToast()
    local holder = new("Frame", {
        Name = "ExtToast", Visible = false,
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0, -50),
        Size = UDim2.fromOffset(0, 40),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundColor3 = COLORS.panel,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0, ZIndex = 200, Parent = gui,
    })
    corner(holder, 10)
    stroke(holder, COLORS.border, 0.15, 1)
    new("UIPadding", {
        PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 18),
        Parent = holder,
    })
    local accentBar = new("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(3, 22),
        BackgroundColor3 = COLORS.accent,
        BorderSizePixel = 0, ZIndex = 201, Parent = holder,
    })
    corner(accentBar, 2)
    local iconLabel = label(holder, "•", 16, COLORS.accent, Enum.Font.SourceSansBold, {
        Position = UDim2.fromOffset(12, 0), Size = UDim2.fromOffset(20, 40), ZIndex = 201,
    })
    local textLabel = label(holder, "", 12, COLORS.text, Enum.Font.SourceSansSemibold, {
        Position = UDim2.fromOffset(34, 0),
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X, ZIndex = 201,
    })
    local conn
    return function(msg, color, icon)
        color = color or COLORS.accent
        icon = icon or "•"
        if conn then conn:Disconnect() end
        holder.Visible = true
        holder.Position = UDim2.new(0.5, 0, 0, -50)
        holder.BackgroundTransparency = 0.05
        accentBar.BackgroundColor3 = color
        iconLabel.Text = icon
        iconLabel.TextColor3 = color
        textLabel.Text = msg
        textLabel.TextColor3 = COLORS.text
        textLabel.TextTransparency = 0
        accentBar.BackgroundTransparency = 0
        TweenService:Create(holder, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, 0, 0, 20),
        }):Play()
        conn = task.delay(2.6, function()
            local t = TweenService:Create(holder, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Position = UDim2.new(0.5, 0, 0, -50), BackgroundTransparency = 1,
            })
            local t2 = TweenService:Create(textLabel, TweenInfo.new(0.2), {TextTransparency = 1})
            t:Play(); t2:Play()
            t.Completed:Wait()
            holder.Visible = false
            holder.BackgroundTransparency = 0.05
            textLabel.TextTransparency = 0
        end)
    end
end

