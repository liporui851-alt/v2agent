local commandHistory = {}

local function pushCommand(text)
    table.insert(commandHistory, 1, { text = text, time = os.time() })
    if #commandHistory > 50 then table.remove(commandHistory, 51) end
end

local function formatTime(t)
    return os.date("%H:%M:%S", t)
end

local function buildHistoryPanel()
