        if toastConn then toastConn:Disconnect() end
        toastHolder.Visible = true
        toastHolder.Position = UDim2.new(0.5, 0, 0, -60)
        toastHolder.BackgroundColor3 = COLORS.panel
        toastHolder.BackgroundTransparency = 0.05
