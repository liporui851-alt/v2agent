                    child:Destroy()
                end
            end
        end
        toast("已清空对话", COLORS.green, "✓")
    elseif isCtrl and input.KeyCode == Enum.KeyCode.W then
        closeAllOthers(wsPanel)
        if wsPanel.Visible then
            wsOverlay.Visible = false
