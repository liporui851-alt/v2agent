    if processed then return end
    local isCtrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
        or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
    if isCtrl and input.KeyCode == Enum.KeyCode.H then
