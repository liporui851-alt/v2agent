local tooltipHolder = new("Frame", {
    Name = "ExtTooltip", Visible = false,
    BackgroundColor3 = Color3.fromRGB(14, 17, 26),
    BackgroundTransparency = 0.05, BorderSizePixel = 0,
    Size = UDim2.fromOffset(0, 26),
    AutomaticSize = Enum.AutomaticSize.X,
    ZIndex = 300, Parent = gui,
})
corner(tooltipHolder, 6)
stroke(tooltipHolder, COLORS.border, 0.2, 1)
new("UIPadding", {
    PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = tooltipHolder,
})
local tooltipLabel = label(tooltipHolder, "", 11, COLORS.text, Enum.Font.SourceSans, {
    Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, ZIndex = 301,
})

local function attachTooltip(btn, text)
    btn.MouseEnter:Connect(function()
        tooltipLabel.Text = text
        tooltipHolder.Visible = true
        local absPos = btn.AbsolutePosition
        local absSize = btn.AbsoluteSize
        task.defer(function()
            tooltipHolder.Position = UDim2.fromOffset(
                absPos.X - tooltipHolder.AbsoluteSize.X - 10,
                absPos.Y + absSize.Y / 2 - 13
            )
        end)
    end)
    btn.MouseLeave:Connect(function() tooltipHolder.Visible = false end)
    bindClick(btn, function() tooltipHolder.Visible = false end)
end

