    local function runAgent(userInput)
        if state.running then
            showToast("上一个任务还在跑")
            return
        end
        state.running = true
        state.requestToken += 1
        local token = state.requestToken

        if CONFIG.API_KEY == "" then
            addMessage("assistant", "请先在设置里填入 DeepSeek API Key。")
            state.running = false
            return
        end

        table.insert(state.conversationHistory, { role = "user", content = userInput })
        trimConversation()

        local messages = { { role = "system", content = buildSystemPrompt() } }
        for _, m in ipairs(state.conversationHistory) do
            table.insert(messages, m)
        end

        stopButton.Visible = true
        sendButton.Visible = false
        thinkingDots.Visible = true
        hint.Visible = false

        local loopCount = 0
        while loopCount < CONFIG.MAX_LOOPS do
            loopCount += 1
            if not state.running or token ~= state.requestToken then break end

            local reply, err = callDeepSeek(messages)
            if err then
                thinkingDots.Visible = false
                hint.Visible = true
                stopButton.Visible = false
                sendButton.Visible = true
                addMessage("assistant", "错误: " .. err, {retry = true, retryPrompt = userInput})
                state.running = false
                return
            end

            state.totalTokens = estimateMessagesTokens(messages) + estimateTokens(reply)
            updateTokenDisplay()

            if CONFIG.TOKEN_LIMIT_ENABLED and state.totalTokens > CONFIG.TOKEN_LIMIT then
                thinkingDots.Visible = false
                hint.Visible = true
                stopButton.Visible = false
                sendButton.Visible = true
                addMessage("assistant", "已超出 token 上限，停止。", {retry = true, retryPrompt = userInput})
                state.running = false
                return
            end

            table.insert(messages, { role = "assistant", content = reply })
            table.insert(state.conversationHistory, { role = "assistant", content = reply })

            local tool, args = parseToolCall(reply)

            if tool and TOOLS[tool] then
                thinkingDots.Visible = false
                local argsStr = HttpService:JSONEncode(args)
                local result
                local ok

                if tool == "run_code" and CONFIG.AUTO_EXECUTE then
                    local success, res = autoExecute(args.code or "")
                    result = res
                    ok = success
                    state.lastCode = args.code or ""
                else
                    result = TOOLS[tool](args)
                    ok = not result:find("失败") and not result:find("错误")
                    if tool == "run_code" then
                        state.lastCode = args.code or ""
                    end
                end

                addToolMessage(tool, argsStr, result, ok)
                thinkingDots.Visible = true

                local toolMsg = tool .. " 返回: " .. result
                table.insert(messages, { role = "user", content = toolMsg })
                table.insert(state.conversationHistory, { role = "user", content = toolMsg })
            else
                thinkingDots.Visible = false
                hint.Visible = true
                stopButton.Visible = false
                sendButton.Visible = true

                local extracted = extractCode(reply)
                if extracted then
                    state.lastCode = extracted
                    addMessage("assistant", "", { code = extracted, retry = true, retryPrompt = userInput })
                else
                    addMessage("assistant", reply, { retry = true, retryPrompt = userInput })
                end
                state.running = false
                return
            end
        end

        thinkingDots.Visible = false
        hint.Visible = true
        stopButton.Visible = false
        sendButton.Visible = true
        state.running = false
    end

