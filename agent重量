    local function typewriter(lbl, text, speed)
        lbl.Text = ""
        local i = 0
        local task = AnimRegistry:add(lbl, function(dt)
            i = i + dt * (speed or 60)
            local n = math.floor(i)
            if n >= #text then
                lbl.Text = text
                AnimRegistry:remove(task)
            else
                lbl.Text = text:sub(1, n)
            end
        end)
    end

