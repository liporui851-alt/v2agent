local AnimRegistry = { tasks = {} }
function AnimRegistry:add(owner, fn)
    local t = { owner = owner, fn = fn, alive = true }
    table.insert(self.tasks, t)
    return t
end
function AnimRegistry:remove(t) t.alive = false end

local animTime = 0
RunService.Heartbeat:Connect(function(dt)
    animTime = animTime + dt
    for i = #AnimRegistry.tasks, 1, -1 do
        local t = AnimRegistry.tasks[i]
        if not t.alive or not t.owner or not t.owner.Parent then
            table.remove(AnimRegistry.tasks, i)
        else
            pcall(t.fn, dt, animTime)
        end
    end
end)

