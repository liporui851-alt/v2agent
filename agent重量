        local task = AnimRegistry:add(label, function(dt)
            i = i + dt * (speed or 60)
            local n = math.floor(i)
            if n >= #text then
                label.Text = text
                AnimRegistry:remove(task)
            else
                label.Text = text:sub(1, n)
            end
        end)
    end

