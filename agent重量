    local function beginDrag(target, input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            local st = dragState[target]
            st.active = true
            st.start = input.Position
            st.origin = (target == "window") and main.Position or ball.Position
        end
    end
    local function updateDrag(target, input)
        local st = dragState[target]
        if not st.active then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - st.start
            local obj = (target == "window") and main or ball
            obj.Position = UDim2.new(
                st.origin.X.Scale, st.origin.X.Offset + delta.X,
                st.origin.Y.Scale, st.origin.Y.Offset + delta.Y
            )
        end
    end
    local function endDrag(target, input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragState[target].active = false
        end
    end

