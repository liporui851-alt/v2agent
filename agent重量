local function addParticles(frame, count)
    count = count or 12
    local holder = Instance.new("Frame")
    holder.Name = "Particles"
    holder.Size = UDim2.new(1, 0, 1, 0)
    holder.BackgroundTransparency = 1
    holder.ClipsDescendants = true
    holder.ZIndex = 0
    holder.Parent = frame

    local particles = {}
    for i = 1, count do
        local p = Instance.new("Frame")
        p.Size = UDim2.fromOffset(math.random(2, 4), math.random(2, 4))
        p.Position = UDim2.new(math.random(), 0, math.random(), 0)
        p.BackgroundColor3 = (i % 3 == 0) and C.accent2 or (i % 3 == 1) and C.accent or C.accent3
        p.BackgroundTransparency = 0.5
        p.BorderSizePixel = 0
        p.Parent = holder
        local pc = Instance.new("UICorner")
        pc.CornerRadius = UDim.new(1, 0)
        pc.Parent = p
        table.insert(particles, {
            obj = p,
            speedX = (math.random() - 0.5) * 0.03,
            speedY = -(0.01 + math.random() * 0.03),
            phase = math.random() * math.pi * 2,
        })
    end

    AnimRegistry:add(holder, function(dt)
        for _, p in ipairs(particles) do
            local pos = p.obj.Position
            local nx = pos.X.Scale + p.speedX * dt
            local ny = pos.Y.Scale + p.speedY * dt
            if ny < -0.05 then ny = 1.05 end
            if nx < -0.05 then nx = 1.05 end
            if nx > 1.05 then nx = -0.05 end
            p.obj.Position = UDim2.new(nx, 0, ny, 0)
            p.phase = p.phase + dt * 2
            p.obj.BackgroundTransparency = 0.4 + math.sin(p.phase) * 0.3
        end
    end)

    return holder
end

local function createThinkingDots(parent)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.fromOffset(60, 16)
    holder.BackgroundTransparency = 1
    holder.Visible = false
    holder.Parent = parent

    local dots = {}
    for i = 1, 3 do
        local d = Instance.new("Frame")
        d.Size = UDim2.fromOffset(6, 6)
        d.Position = UDim2.fromOffset((i-1) * 14, 5)
        d.BackgroundColor3 = C.accent
        d.BorderSizePixel = 0
        d.Parent = holder
        local dc = Instance.new("UICorner")
        dc.CornerRadius = UDim.new(1, 0)
        dc.Parent = d
        table.insert(dots, d)
    end

    local active = false
    AnimRegistry:add(holder, function(dt, t)
        if not active then return end
        for i, d in ipairs(dots) do
            local phase = t * 4 - (i - 1) * 0.5
            local y = math.abs(math.sin(phase)) * -7
            d.Position = UDim2.fromOffset((i-1) * 14, 5 + y)
            local alpha = 0.5 + 0.5 * math.abs(math.sin(phase))
            d.BackgroundTransparency = 1 - alpha
            d.BackgroundColor3 = Color3.fromRGB(
                130 + math.sin(phase) * 40,
                170 + math.cos(phase) * 40,
                255
            )
        end
    end)

    local function start()
        holder.Visible = true
        active = true
    end

    local function stop()
        holder.Visible = false
        active = false
    end

    return holder, start, stop
end

local function typewriter(label, text, speed, onDone)
    label.Text = ""
    local i = 0
    local task = AnimRegistry:add(label, function(dt)
        i = i + dt * (speed or 60)
        local n = math.floor(i)
        if n >= #text then
            label.Text = text
            AnimRegistry:remove(task)
            if onDone then onDone() end
        else
            label.Text = text:sub(1, n)
        end
    end)
    return task
end

