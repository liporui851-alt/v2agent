    local function runAgent(userInput)
        if state.running then return end
        state.running = true
        state.requestToken += 1
        local token = state.requestToken

        if CONFIG.API_KEY == "" then
            addMessage("assistant", "请先在设置里填入 API Key。")
            state.running = false
            stopBtn.Visible = false
            sendButton.Visible = true
            thinkingHolder.Visible = false
            return
        end

        table.insert(state.conversationHistory, { role = "user", content = userInput })
        local messages = { { role = "system", content = buildSystemPrompt() } }
        for _, m in ipairs(state.conversationHistory) do
            table.insert(messages, m)
        end

        local loopCount = 0
        while loopCount < CONFIG.MAX_LOOPS do
            loopCount += 1
            if not state.running or token ~= state.requestToken then break end
            local reply, err = callAPI(messages)
            if err then
                addMessage("assistant", "错误: " .. err)
                break
            end
            state.totalTokens = state.totalTokens + estimateTokens(reply)
            updateTokenDisplay()
            table.insert(messages, { role = "assistant", content = reply })
            table.insert(state.conversationHistory, { role = "assistant", content = reply })
            local tool, args = parseTool(reply)
            if tool and TOOLS[tool] then
                local result
                if tool == "run_code" and CONFIG.AUTO_EXECUTE then
                    local success, res = autoExecute(args.code or "")
                    result = res
                else
                    result = TOOLS[tool](args)
                end
                addToolCard(tool, HttpService:JSONEncode(args), result, not result:find("失败") and not result:find("错误"))
                local toolMsg = tool .. " 返回: " .. result
                table.insert(messages, { role = "user", content = toolMsg })
                table.insert(state.conversationHistory, { role = "user", content = toolMsg })
            else
                local extracted = extractCode(reply)
                if extracted then
                    addMessage("assistant", "", { code = extracted })
                else
                    addMessage("assistant", reply)
                end
                break
            end
        end

        state.running = false
        stopBtn.Visible = false
        sendButton.Visible = true
        thinkingHolder.Visible = false
    end

