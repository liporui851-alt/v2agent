        TweenService:Create(toastHolder, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, 0, 0, 20),
        }):Play()
        toastConn = task.delay(2.6, function()
            local t = TweenService:Create(toastHolder, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Position = UDim2.new(0.5, 0, 0, -60), BackgroundTransparency = 1,
            })
            local t2 = TweenService:Create(toastText, TweenInfo.new(0.2), {TextTransparency = 1})
            t:Play(); t2:Play()
            t.Completed:Wait()
            toastHolder.Visible = false
            toastHolder.BackgroundTransparency = 0.05
            toastText.TextTransparency = 0
        end)
    end

